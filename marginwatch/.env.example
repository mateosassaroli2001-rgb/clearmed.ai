# Copiá este archivo como .env y completá los valores.
# El archivo .env NO se sube a git (está en .gitignore). Nunca compartas tu clave.

# Proveedor de extracción de facturas: "anthropic" o "none" (sin IA, carga manual).
EXTRACTION_PROVIDER=anthropic

# Clave de la API de Anthropic (Claude). Se crea en https://console.anthropic.com/
# Si la dejás vacía, la app funciona igual pero la extracción automática queda pendiente.
ANTHROPIC_API_KEY=

# Modelo de Claude para leer facturas (opcional).
EXTRACTION_MODEL=claude-opus-5-5

# Puerto local donde se abre la app: http://localhost:3000
PORT=3000

# Tamaño máximo de factura en MB (opcional).
MAX_INVOICE_MB=10

# Carpeta donde se guardan tus datos y facturas (opcional).
DATA_DIR=data
