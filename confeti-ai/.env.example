# Copiá este archivo como .env y completá tus keys
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe: https://dashboard.stripe.com/apikeys
# Si dejás esto vacío, la app corre en "modo demo": publicar una web
# se salta el pago para que puedas probar el flujo completo gratis.
STRIPE_SECRET_KEY=

# Precio de publicar una web (en centavos de USD). Placeholder, se
# puede ajustar en cualquier momento sin tocar código.
PRICE_USD_CENTS=3000

PORT=3000
BASE_URL=http://localhost:3000
